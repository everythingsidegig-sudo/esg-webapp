NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: never prefix with NEXT_PUBLIC_, never import from client code.
# Required for account deletion (src/app/api/account/delete/route.ts), which
# is the only place this should ever be read.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
